# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Milestone 1 needs no secrets: the only model is a local mock.

# Docker context to use if your active context is not running (e.g. Docker Desktop stopped).
# DOCKER_CONTEXT=default

# Sandbox image tag the harness runs untrusted code in.
# EVALHARNESS_SANDBOX_IMAGE=evalharness-sandbox:0.1.0

# Reserved for later, NOT used yet. Real model calls require explicit approval.
# ANTHROPIC_API_KEY=
