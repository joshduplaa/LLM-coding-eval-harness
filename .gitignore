# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Harness output (may contain model-generated code)
runs/
results/
*.sqlite
*.db

# Editors / OS
.vscode/
.idea/
.DS_Store

# Terraform: provider cache, state (can contain secrets), and real variable values
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.tfvars
!*.tfvars.example
.terraformrc
terraform.rc
