{
  "uid": "evalharness",
  "title": "evalharness: pass rates (MOCK DATA)",
  "tags": [
    "evalharness",
    "mock"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(evalharness_samples_scored, model_id)",
          "refId": "m"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 5
      },
      "targets": [],
      "options": {
        "mode": "markdown",
        "content": "## ⚠ MOCK DATA: synthetic output, not a measurement of any real model\nEvery series carries `is_mock`. Until real model calls are approved, every model here is a **mock** that returns canned solutions. Rates are shown with their 95% Wilson interval and sample size `n`; harness errors are excluded from `n` and counted separately. Samples of the same task are correlated, so the true uncertainty is wider than shown. Nothing here compares models."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Mock models shown",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(evalharness_samples_scored{task=\"_all\",is_mock=\"true\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Runs stored",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "evalharness_runs_stored",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Latest run per model: pass rate, 95% CI, sample size",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (model_id, is_mock) (evalharness_pass_rate{model_id=~\"$model\",task=\"_all\"})",
          "refId": "rate",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (model_id, is_mock) (evalharness_pass_rate_ci_low{model_id=~\"$model\",task=\"_all\"})",
          "refId": "low",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (model_id, is_mock) (evalharness_pass_rate_ci_high{model_id=~\"$model\",task=\"_all\"})",
          "refId": "high",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (model_id, is_mock) (evalharness_samples_scored{model_id=~\"$model\",task=\"_all\"})",
          "refId": "n",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (model_id, is_mock) (evalharness_samples_excluded{model_id=~\"$model\",task=\"_all\"})",
          "refId": "excluded",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "task": true
            },
            "renameByName": {
              "Value #rate": "pass rate",
              "Value #low": "95% CI low",
              "Value #high": "95% CI high",
              "Value #n": "n (scored)",
              "Value #excluded": "harness errors (excluded)"
            },
            "indexByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pass rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "95% CI low"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "95% CI high"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "is_mock"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "MOCK",
                        "color": "red"
                      },
                      "false": {
                        "text": "real",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Latest run per model, by task",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (model_id, task, is_mock) (evalharness_pass_rate{model_id=~\"$model\",task!=\"_all\"})",
          "refId": "rate",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (model_id, task, is_mock) (evalharness_pass_rate_ci_low{model_id=~\"$model\",task!=\"_all\"})",
          "refId": "low",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (model_id, task, is_mock) (evalharness_pass_rate_ci_high{model_id=~\"$model\",task!=\"_all\"})",
          "refId": "high",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (model_id, task, is_mock) (evalharness_samples_scored{model_id=~\"$model\",task!=\"_all\"})",
          "refId": "n",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (model_id, task, is_mock) (evalharness_samples_excluded{model_id=~\"$model\",task!=\"_all\"})",
          "refId": "excluded",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value #rate": "pass rate",
              "Value #low": "95% CI low",
              "Value #high": "95% CI high",
              "Value #n": "n (scored)",
              "Value #excluded": "harness errors (excluded)"
            },
            "indexByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pass rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "95% CI low"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "95% CI high"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "is_mock"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "MOCK",
                        "color": "red"
                      },
                      "false": {
                        "text": "real",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Samples by result category (latest run, all tasks)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "evalharness_samples{model_id=~\"$model\",task=\"_all\"}",
          "refId": "A",
          "legendFormat": "{{model_id}} · {{category}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8AB8FF"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*· passed$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*· sandbox_violation$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*· harness_error$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Overall pass rate over time, with 95% CI band",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "evalharness_pass_rate_ci_high{model_id=~\"$model\",task=\"_all\"}",
          "refId": "high",
          "legendFormat": "{{model_id}} CI high",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "evalharness_pass_rate{model_id=~\"$model\",task=\"_all\"}",
          "refId": "rate",
          "legendFormat": "{{model_id}} pass rate",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "evalharness_pass_rate_ci_low{model_id=~\"$model\",task=\"_all\"}",
          "refId": "low",
          "legendFormat": "{{model_id}} CI low",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "The value changes only when a newer run of a model is stored.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*CI high"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "${__field.labels.model_id} CI low"
              },
              {
                "id": "custom.fillOpacity",
                "value": 15
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*CI low"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*pass rate"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      }
    }
  ]
}
